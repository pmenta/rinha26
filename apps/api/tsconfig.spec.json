{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "out-tsc/vitest",
    "tsBuildInfoFile": "out-tsc/vitest/tsconfig.spec.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["bun-types", "node", "vitest/globals"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "scripts/**/*.ts"
  ],
  "references": [
    { "path": "../../packages/core/tsconfig.lib.json" },
    { "path": "../../packages/vector-store/tsconfig.lib.json" }
  ]
}
