{
  "name": "@rinha26/vector-store",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@rinha26/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "vector-store",
    "tags": ["scope:vector-store"],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": ["{projectRoot}/dist"],
        "options": {
          "cwd": "{projectRoot}",
          "commands": ["tsc --build tsconfig.build.json"],
          "parallel": false
        }
      },
      "bench": {
        "executor": "nx:run-commands",
        "outputs": ["{projectRoot}/bench-results"],
        "cache": false,
        "dependsOn": ["build"],
        "options": {
          "cwd": "{projectRoot}",
          "command": "bun bench/run-bench.ts"
        }
      }
    }
  },
  "dependencies": {
    "@rinha26/core": "*",
    "typescript-monads": "^9.5.0"
  }
}
